
#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# UNIC_CRIPTON - Roteador Multiblockchain
# Compatível com execução local e diretamente pelo GitHub.
# ============================================================

REPO_ARCHIVE="https://codeload.github.com/wscouto2501/multcriptonrede/tar.gz/refs/heads/main"

BOOTSTRAP_DIR=""

cleanup() {
    if [[ -n "$BOOTSTRAP_DIR" && -d "$BOOTSTRAP_DIR" ]]; then
        rm -rf -- "$BOOTSTRAP_DIR"
    fi
}
trap cleanup EXIT

fail() {
    printf '\nERRO: %s\n' "$*" >&2
    exit 1
}

# ------------------------------------------------------------
# 1. Identificação automática da raiz do projeto
# ------------------------------------------------------------

SOURCE_DIR=""

SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || true

if [[ -n "$SOURCE_DIR" &&
      -s "$SOURCE_DIR/parametro" &&
      -s "$SOURCE_DIR/modules/common/catalog.js" ]]; then

    ROOT_DIR="$SOURCE_DIR"
    echo "Projeto local identificado: $ROOT_DIR"

else

    echo "Execução remota identificada."
    echo "Preparando arquivos do projeto..."

    command -v curl >/dev/null 2>&1 || fail "curl não encontrado."
    command -v tar >/dev/null 2>&1 || fail "tar não encontrado."

    BOOTSTRAP_DIR="$(mktemp -d /tmp/unic-cripton.XXXXXX)"

    curl -fsSL --retry 3 "$REPO_ARCHIVE" |
        tar -xz --strip-components=1 -C "$BOOTSTRAP_DIR" \
        || fail "Não foi possível baixar os arquivos do repositório."

    ROOT_DIR="$BOOTSTRAP_DIR"

fi

export UNIC_CRIPTON_ROOT="$ROOT_DIR"

PARAM_FILE="$ROOT_DIR/parametro"
COMMON_DIR="$ROOT_DIR/modules/common"

[[ -s "$PARAM_FILE" ]] || fail "Catálogo não encontrado: $PARAM_FILE"
[[ -s "$COMMON_DIR/catalog.js" ]] || fail "Arquivo catalog.js não encontrado."

# ------------------------------------------------------------
# 2. Verificação e instalação do Node.js
# ------------------------------------------------------------

node_is_valid() {
    command -v node >/dev/null 2>&1 || return 1

    node -e '
        const major = Number(process.versions.node.split(".")[0]);
        process.exit(major >= 20 ? 0 : 1);
    ' >/dev/null 2>&1
}

if ! node_is_valid; then

    echo "Node.js 20 ou superior não encontrado."
    echo "Iniciando instalação..."

    if command -v apt-get >/dev/null 2>&1; then

        apt-get -o DPkg::Lock::Timeout=300 update
        apt-get -o DPkg::Lock::Timeout=300 install -y ca-certificates curl
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
        apt-get -o DPkg::Lock::Timeout=300 install -y nodejs

    elif command -v dnf >/dev/null 2>&1; then

        dnf install -y nodejs

    elif command -v yum >/dev/null 2>&1; then

        yum install -y nodejs

    elif command -v apk >/dev/null 2>&1; then

        apk add --no-cache nodejs npm

    else

        fail "Gerenciador de pacotes não identificado. Instale Node.js 20 ou superior."

    fi

fi

node_is_valid || fail "Node.js 20 ou superior é obrigatório."

NODE_VERSION="$(node -p 'process.versions.node')"

echo "Node.js $NODE_VERSION instalado e validado."

# ------------------------------------------------------------
# 3. Verificação de permissões
# ------------------------------------------------------------

[[ "${EUID:-$(id -u)}" -eq 0 ]] ||
    fail "Execute como root."

# ------------------------------------------------------------
# 4. Validação do catálogo multiblockchain
# ------------------------------------------------------------

echo ""
echo "Validando catálogo de redes..."

node "$COMMON_DIR/catalog.js" validate "$PARAM_FILE" ||
    fail "Catálogo inválido. Consulte o erro acima."

mapfile -t NETWORKS < <(
    node "$COMMON_DIR/catalog.js" list "$PARAM_FILE"
)

((${#NETWORKS[@]} > 0)) ||
    fail "Nenhuma rede está habilitada para seleção."

# ------------------------------------------------------------
# 5. Menu de seleção
# ------------------------------------------------------------

printf '\n============================================================\n'
printf '             UNIC_CRIPTON MULTIBLOCKCHAIN\n'
printf '============================================================\n'
printf 'Selecione a rede desejada.\n\n'

for i in "${!NETWORKS[@]}"; do

    IFS=$'\t' read -r \
        key name family module environment deploy standard reason \
        <<< "${NETWORKS[$i]}"

    if [[ "$deploy" == "true" ]]; then
        status="DEPLOY DISPONÍVEL"
    else
        status="SEM DEPLOY"
    fi

    printf '%2d) %-24s | %-9s | %-8s | %s\n' \
        "$((i+1))" \
        "$name" \
        "$family" \
        "${environment:-n/a}" \
        "$status"

done

printf '\n'

read -r -p 'Número da rede (0 para sair): ' choice

[[ "$choice" =~ ^[0-9]+$ ]] ||
    fail "Opção inválida."

if (( choice == 0 )); then
    echo "Operação cancelada."
    exit 0
fi

(( choice >= 1 && choice <= ${#NETWORKS[@]} )) ||
    fail "Opção fora da lista."

IFS=$'\t' read -r \
    NETWORK_KEY \
    NETWORK_NAME \
    NETWORK_FAMILY \
    NETWORK_MODULE \
    NETWORK_ENV \
    NETWORK_DEPLOY \
    NETWORK_STANDARD \
    NETWORK_REASON \
    <<< "${NETWORKS[$((choice-1))]}"

printf '\nRede: %s\n' "$NETWORK_NAME"
printf 'Família: %s | Módulo: %s | Ambiente: %s\n' \
    "$NETWORK_FAMILY" \
    "$NETWORK_MODULE" \
    "${NETWORK_ENV:-não definido}"

# ------------------------------------------------------------
# 6. Encaminhamento para o módulo correspondente
# ------------------------------------------------------------

case "$NETWORK_MODULE" in

    evm)

        module_file="$ROOT_DIR/modules/evm/installer.sh"

        [[ -f "$module_file" ]] ||
            fail "Módulo EVM não encontrado."

        export UNIC_CRIPTON_SELECTED_NETWORK_KEY="$NETWORK_KEY"

        bash "$module_file"
        ;;

    solana)

        module_file="$ROOT_DIR/modules/solana/module.sh"

        [[ -f "$module_file" ]] ||
            fail "Módulo Solana não encontrado."

        export UNIC_CRIPTON_NETWORK_KEY="$NETWORK_KEY"

        bash "$module_file"
        ;;

    tron|sui|aptos|ton)

        fail "O módulo '$NETWORK_MODULE' está preparado como adaptador, mas ainda não implementa deploy."

        ;;

    *)

        fail "Módulo desconhecido no catálogo: $NETWORK_MODULE"

        ;;

esac
