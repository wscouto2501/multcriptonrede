#!/usr/bin/env bash
set -Eeuo pipefail

# UNIC_CRIPTON - roteador multiblockchain. O módulo EVM legado é preservado.
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$ROOT_DIR/parametro"
COMMON_DIR="$ROOT_DIR/modules/common"

fail(){ printf 'ERRO: %s\n' "$*" >&2; exit 1; }
[[ "${EUID:-$(id -u)}" -eq 0 ]] || fail "Execute como root: sudo bash '$0'"
command -v node >/dev/null 2>&1 || fail "Node.js é obrigatório para ler o catálogo. Instale Node.js 20 ou superior."
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' || fail "Node.js 20 ou superior é obrigatório."
[[ -s "$PARAM_FILE" ]] || fail "Catálogo não encontrado: $PARAM_FILE"

# Valida JSON, chaves únicas e estrutura mínima antes de mostrar opções.
node "$COMMON_DIR/catalog.js" validate "$PARAM_FILE" || fail "Catálogo inválido. Consulte o erro acima."
mapfile -t NETWORKS < <(node "$COMMON_DIR/catalog.js" list "$PARAM_FILE")
((${#NETWORKS[@]} > 0)) || fail "Nenhuma rede está habilitada para seleção."

printf '\n============================================================\n'
printf '             UNIC_CRIPTON MULTIBLOCKCHAIN\n'
printf '============================================================\n'
printf 'Selecione a rede. A disponibilidade de deploy é verificada pelo módulo.\n\n'
for i in "${!NETWORKS[@]}"; do
  IFS=$'\t' read -r key name family module environment deploy standard reason <<<"${NETWORKS[$i]}"
  if [[ "$deploy" == "true" ]]; then status='DEPLOY DISPONÍVEL'; else status='SEM DEPLOY'; fi
  printf '%2d) %-24s | %-9s | %-8s | %s\n' "$((i+1))" "$name" "$family" "${environment:-n/a}" "$status"
done
printf '\n'
read -r -p 'Número da rede (0 para sair): ' choice
[[ "$choice" =~ ^[0-9]+$ ]] || fail "Opção inválida."
(( choice != 0 )) || { echo 'Operação cancelada.'; exit 0; }
(( choice >= 1 && choice <= ${#NETWORKS[@]} )) || fail "Opção fora da lista."
IFS=$'\t' read -r NETWORK_KEY NETWORK_NAME NETWORK_FAMILY NETWORK_MODULE NETWORK_ENV NETWORK_DEPLOY NETWORK_STANDARD NETWORK_REASON <<<"${NETWORKS[$((choice-1))]}"

printf '\nRede: %s\nFamília: %s | Módulo: %s | Ambiente: %s\n' "$NETWORK_NAME" "$NETWORK_FAMILY" "$NETWORK_MODULE" "${NETWORK_ENV:-não definido}"
if [[ "$NETWORK_DEPLOY" != "true" ]]; then
  printf 'Deploy indisponível: %s\n' "${NETWORK_REASON:-módulo ainda não validado}"
  exit 2
fi

case "$NETWORK_MODULE" in
  evm)
    module_file="$ROOT_DIR/modules/evm/installer.sh"
    [[ -x "$module_file" ]] || fail "Módulo EVM ausente ou sem permissão de execução."
    export UNIC_CRIPTON_ROOT="$ROOT_DIR"
    export UNIC_CRIPTON_SELECTED_NETWORK_KEY="$NETWORK_KEY"
    exec bash "$module_file"
    ;;
  solana)
    module_file="$ROOT_DIR/modules/solana/module.sh"
    [[ -x "$module_file" ]] || fail "Módulo Solana ausente ou sem permissão de execução."
    export UNIC_CRIPTON_ROOT="$ROOT_DIR"
    export UNIC_CRIPTON_NETWORK_KEY="$NETWORK_KEY"
    exec bash "$module_file"
    ;;
  tron|sui|aptos|ton)
    fail "O módulo '$NETWORK_MODULE' está preparado como adaptador, mas ainda não implementa deploy."
    ;;
  *) fail "Módulo desconhecido no catálogo: $NETWORK_MODULE" ;;
esac
